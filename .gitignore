# Build output. Everything below is regenerated by the scripts in this repo and
# is far too large to track: a single Linux 6.18.55 build is ~4.3G, and the
# driver's integration tree (kernel source copy + private build dir) adds ~2G
# more. Do NOT commit these -- a stray `git add -A` would try to add gigabytes.

# Per-version kernel trees: src/, build/, artifacts/, logs/ (kernel/build_kernel.sh)
/kernel/[0-9]*.*/

# Downloaded upstream tarballs (kernel/build_kernel.sh), incl. the 148M
# linux-6.18.55.tar.xz. Kept on disk between runs so a rebuild never re-downloads.
kernel/.downloads/

# Driver integration tree, logs and built module (driver/build_driver.sh)
/driver/work/
/driver/logs/
/driver/artifacts/
/driver/src/
/driver/build/

# Console logs captured from detached build runs (LOG_ROOT in workspace.env)
/logs/

# Kernel and rootfs artifacts, if ARTIFACT_ROOT is populated
/artifacts/